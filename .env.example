# Copy to .env and adjust. All configuration is environment-driven, so the same
# image runs unchanged across dev / stg / prd — only these values differ.

# --- tracker identity / server ---
APP_ENV=dev                 # dev | stg | prd (shown in the UI + logs)
HTTP_PORT=18090             # host port mapped to the app (compose)
HTTP_ADDR=:18090            # listen address; compose pins this too

# --- database ---
# For docker-compose these three are enough; DATABASE_URL is assembled from them
# in docker-compose.yml. For a standalone binary, set DATABASE_URL directly.
POSTGRES_USER=certtracker
POSTGRES_PASSWORD=certtracker
POSTGRES_DB=certtracker
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=disable

# --- scheduler ---
SCHEDULER_ENABLED=true
SCHEDULER_RUN_AT=09:00      # daily reminder scan, HH:MM in TIMEZONE
TIMEZONE=Asia/Taipei        # IANA name; falls back to UTC if unknown

# --- severity thresholds (days remaining) ---
# Drive the colour/level shown in the UI and notifications.
SEVERITY_NOTICE_DAYS=90
SEVERITY_WARNING_DAYS=60
SEVERITY_URGENT_DAYS=30
SEVERITY_CRITICAL_DAYS=7

# --- default reminder lead times offered in the form ---
REMINDER_DEFAULT_DAYS=30,45,60,75,90

# --- authentication & access control ---
# Every API call needs a session. Set to false ONLY for local development:
# it makes every request run as the bootstrap admin with no login at all.
AUTH_ENABLED=true
SESSION_TTL_HOURS=12               # sliding: an active session keeps extending
COOKIE_SECURE=                     # blank = derived from BASE_URL (https -> true)
TRUSTED_ORIGIN=                    # blank = same-origin only; set behind a proxy

# First run only, applied when the users table is empty. Leave the password
# blank and the tracker generates one and prints it to stdout once.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# --- escalating reminder cadence ---
# Milestones above fire once each. This ladder then REPEATS the alert, more
# often the closer expiry gets. Format: within_days:every_days, comma separated.
# Default: under 45 days every 5, under 30 every 3, under 10 (and once expired)
# every day. The tightest matching rung wins.
REMINDER_ESCALATION=45:5,30:3,10:1

# --- renewal evidence upload ---
MAX_UPLOAD_MB=5                    # per proof image (PNG/JPEG/WebP/GIF only)
PASSWORD_RESET_TTL_MINUTES=30      # how long a mailed one-time password lasts
PASSWORD_RESET_COOLDOWN_SECONDS=120  # min gap between reset mails for one account

# --- email (SMTP). Leave SMTP_HOST blank to disable email delivery. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=cert-tracker@example.com
SMTP_USE_TLS=false                 # true for implicit TLS (port 465)
SMTP_INSECURE_SKIP_VERIFY=false    # true for internal relays with self-signed certs

# --- links inside notifications (optional) ---
BASE_URL=http://localhost:18090
